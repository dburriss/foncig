<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- The package version. scripts/publish.fsx rewrites Version and PackageReleaseNotes here. -->
    <Version>0.1.0</Version>
    <!-- The Fnode packages this library builds on (Fnode.Core / Fnode.Json / Fnode.Yaml move in lockstep). -->
    <FnodeVersion>0.2.0</FnodeVersion>
    <PackageReleaseNotes>`Foncig.Core`: layered configuration with flat, case-insensitive, colon-separated keys; last source wins.
Flattening of `Node` trees with deterministic, culture-free scalar text (identical on .NET, Fable JS and Fable Python),
Provenance on every entry (`source`, `file:line:col`, env var name or CLI token) and `Config.explain` with the full
List merge policies `Replace` (default), `MergeByIndex` (the .NET behaviour) and `Append`, global or per key prefix.
Environment variable source (prefix filter, `__` as `:`) and command-line source (`--k v`, `--k=v`, `--k:sub v`,
Typed access (`int`, `int64`, `float`, `bool`, `Guid`, `Uri`, `TimeSpan`, `DateTimeOffset`, lists, maps), section
Reflection-free record sources through explicit encoders (`Encode`, `ConfigSource.ofRecord`).
`Foncig.Host` (environment, arguments, file reading, home and working directory, path helpers, upward search),
Packages ship their F# sources under `fable/` for Fable JavaScript and Python consumers.</PackageReleaseNotes>
    <Authors>Devon Burriss</Authors>
    <Copyright>Copyright © 2026 Devon Burriss</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dburriss/foncig</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dburriss/foncig</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <OtherFlags>$(OtherFlags) --nowarn:57</OtherFlags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <!-- Explicit FSharp.Core floor for packed projects (same as Fnode 0.2.0), so it does not follow the CI SDK. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('Tests')) And !$(MSBuildProjectName.EndsWith('Fable'))">
    <FSharpCoreImplicitPackageVersion>8.0.403</FSharpCoreImplicitPackageVersion>
  </PropertyGroup>
</Project>