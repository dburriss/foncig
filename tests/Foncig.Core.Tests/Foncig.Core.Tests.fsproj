<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <!-- Keep in sync with ../Foncig.Fable/Foncig.Fable.fsproj (the Fable run compiles these same files). -->
  <ItemGroup>
    <Compile Include="KeyTests.fs" />
    <Compile Include="ScalarTests.fs" />
    <Compile Include="FlattenTests.fs" />
    <Compile Include="MergeTests.fs" />
    <Compile Include="EnvArgsTests.fs" />
    <Compile Include="ConfigTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="FsCheck.Xunit.v3" Version="3.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Foncig.Core/Foncig.Core.fsproj" />
  </ItemGroup>

</Project>
